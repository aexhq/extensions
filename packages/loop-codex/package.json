{
  "name": "@aexhq/loop-codex",
  "version": "1.5.0",
  "description": "The codex-style agentloop for Brain sessions: a semantic port of codex's loop policies onto contracts/agentloop/v1, built with the public @aexhq/agentloop toolchain",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aexhq/extensions.git",
    "directory": "packages/loop-codex"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
  },
  "agentloop": {
    "name": "codex-style"
  },
  "exports": {
    ".": { "types": "./index.d.ts", "import": "./index.mjs" },
    "./package": "./dist/loop.brain.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "index.mjs",
    "index.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "npm run build && node --test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@aexhq/agentloop": "0.4.1",
    "@aexhq/brain": "0.7.0"
  },
  "devDependencies": {}
}
