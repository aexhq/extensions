{
  "name": "@aexhq/agentloop-pi",
  "version": "7.2.0",
  "description": "Pi-style parallel-Tool Brain extension",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aexhq/extensions.git",
    "directory": "packages/loop-pi"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "index.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../tools/build-agentloop.mjs src/component.mjs src/index.mjs dist",
    "test": "npm run build && node --test *.test.mjs",
    "test:logic": "node --test loop.test.mjs state.test.mjs",
    "test:logic:watch": "node --test --watch loop.test.mjs state.test.mjs",
    "test:journeys": "node --test test/journeys.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@aexhq/brain": "0.32.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "zod": "4.4.3"
  }
}
