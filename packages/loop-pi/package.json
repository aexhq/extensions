{
  "name": "@aexhq/loop-pi",
  "version": "0.88.0",
  "description": "Pi-style parallel-Tool Agentloop for Brain, built through the universal Component pipeline",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aexhq/extensions.git",
    "directory": "packages/loop-pi"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
