{
  "name": "@aexhq/loop-pi",
  "version": "0.87.0",
  "description": "The pi agentloop for Brain sessions: pinned @earendil-works/pi-agent-core adapted onto contracts/agentloop/v1, built with the public @aexhq/agentloop toolchain",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aexhq/extensions.git",
    "directory": "packages/loop-pi"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
  },
  "agentloop": {
    "name": "pi"
  },
  "exports": {
    ".": { "types": "./index.d.ts", "import": "./index.mjs" },
    "./component": "./dist/loop.component.wasm",
    "./identity": "./dist/identity.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "index.mjs",
    "index.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "npm run build && node --test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@aexhq/brain": "0.4.0"
  },
  "devDependencies": {
    "@aexhq/agentloop": "0.3.2",
    "@bytecodealliance/componentize-js": "0.22.0",
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2"
  }
}
