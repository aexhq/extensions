{
  "name": "@aexhq/tool-read",
  "version": "8.1.0",
  "description": "Read UTF-8 text from a file in the Environment workspace.",
  "license": "MIT",
  "homepage": "https://aex.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aexhq/extensions.git",
    "directory": "packages/tool-read"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./runtime": {
      "types": "./dist/packages/tool-read/src/index.d.ts",
      "import": "./dist/packages/tool-read/src/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../tools/clean-dist.mjs && tsc -p tsconfig.json && node ../../tools/build-tool-runtime.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@aexhq/brain": "0.32.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  },
  "brain": {
    "tools": {
      ".": {
        "runtime": "./runtime",
        "exports": [
          "read"
        ]
      }
    }
  }
}
