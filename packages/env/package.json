{
  "name": "@aexhq/env",
  "version": "0.1.0",
  "description": "An ordinary Brain Tool for scoped Environment control.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aexhq/extensions.git",
    "directory": "packages/env"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/packages/env/src/index.d.ts",
      "import": "./dist/packages/env/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../tools/clean-dist.mjs && tsc -p tsconfig.json && brain-tools",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@aexhq/brain": "0.32.1",
    "zod": "4.4.3"
  },
  "brain": {
    "tools": {
      ".": {
        "runtime": "./runtime",
        "exports": [
          "env"
        ]
      }
    }
  }
}
