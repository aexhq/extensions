{
  "name": "@aexhq/loop-aex",
  "version": "0.1.0",
  "description": "The official aex agentloop: the default hosted policy on contracts/agentloop/v1, built with the public @aexhq/agentloop toolchain",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aexhq/aex-extension.git",
    "directory": "packages/loop-aex"
  },
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=22.0.0" },
  "publishConfig": { "access": "public", "provenance": true, "tag": "next" },
  "agentloop": { "name": "aex" },
  "exports": {
    ".": "./index.mjs",
    "./bundle": "./dist/loop.bundle.mjs",
    "./identity": "./dist/identity.json",
    "./package.json": "./package.json"
  },
  "files": ["dist", "src", "index.mjs", "README.md"],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@aexhq/agentloop": "0.1.0"
  }
}
