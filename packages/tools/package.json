{
  "name": "@aexhq/tools",
  "version": "0.2.6",
  "description": "Official precompiled Tool components for Brain sessions",
  "license": "Apache-2.0",
  "homepage": "https://aex.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aexhq/extensions.git",
    "directory": "packages/tools"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "index.mjs",
    "index.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.mjs",
    "test": "npm run build && node --test"
  },
  "dependencies": {
    "@aexhq/brain": "0.3.1"
  },
  "devDependencies": {
    "@bytecodealliance/componentize-js": "0.22.0",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "zod": "4.4.3"
  }
}
