{
  "name": "@aexhq/env-app",
  "version": "1.0.2",
  "description": "Language-neutral HTTP Environment adapter for Brain sessions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aexhq/extensions.git",
    "directory": "packages/env-app"
  },
  "publishConfig": { "access": "public", "provenance": true, "tag": "next" },
