{
  "name": "@aexhq/tool-todo",
  "version": "8.1.2",
  "description": "Read or replace the session's to-do list.",
  "license": "MIT",
  "homepage": "https://aex.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aexhq/extensions.git",
    "directory": "packages/tool-todo"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./runtime": {
      "types": "./dist/packages/tool-todo/src/index.d.ts",
      "import": "./dist/packages/tool-todo/src/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../tools/clean-dist.mjs && tsc -p tsconfig.json && node ../../tools/build-tool-runtime.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@aexhq/brain": "0.34.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  },
  "brain": {
    "tools": {
      ".": {
        "runtime": "./runtime",
        "exports": [
          "todo"
        ]
      }
    }
  }
}
