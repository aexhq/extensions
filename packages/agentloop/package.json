{
  "name": "@aexhq/agentloop",
  "version": "0.3.0",
  "description": "Author precompiled Agentloop components for Brain sessions against the canonical typed context",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aexhq/extensions.git",
    "directory": "packages/agentloop"
  },
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=22.0.0" },
  "publishConfig": { "access": "public", "provenance": true, "tag": "next" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./build": { "types": "./dist/build.d.ts", "import": "./dist/build.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@aexhq/brain": "0.3.1",
    "esbuild": "0.25.9"
  },
  "devDependencies": {
    "@bytecodealliance/componentize-js": "0.22.0",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
