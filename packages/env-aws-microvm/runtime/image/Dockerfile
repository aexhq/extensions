# The Environment image for **plain Docker** (local development and CI smoke). The guest binary is compiled
# separately (aarch64-unknown-linux-gnu, glibc, matching the ubuntu base) and copied in, so this
# stays a thin, cached runtime layer. The production Lambda MicroVM image is generated by
# `environment-lambda` (crates/environment-lambda/src/image.rs), not from this file — the two share the same
# toolchain but the Lambda image adds a root boot script (DNS pin + swap).
#
#   docker build -f image/Dockerfile --build-arg BIN=target/aarch64-unknown-linux-gnu/release/environment-guest -t environment:dev .
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    HOME=/home/agent \
    PATH=/workspace/.environment/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    ENVIRONMENT_WORKSPACE=/workspace \
    ENVIRONMENT_TOOL_DIR=/var/environment/tools \
    ENVIRONMENT_TOOL_RUNNER=/usr/local/lib/environment/tool-runner.mjs \
    ENVIRONMENT_TOOL_BOUNDARY_LIBRARY=/usr/local/lib/environment/tool-boundary.so \
    ENVIRONMENT_SUPERVISOR_UID=1001 \
    ENVIRONMENT_TOOL_UID=1000 \
    ENVIRONMENT_TOOL_GID=1000 \
    ENVIRONMENT_LISTEN=0.0.0.0:8080

# Curated toolchain. Installers are redirected into /workspace/.environment/** (see ENV above) so their
# output stays in the live workspace generation; no automatic checkpoint or restore exists.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl wget git openssh-client \
      build-essential pkg-config \
      ripgrep jq unzip zip zstd xz-utils file less \
      procps coreutils bash libcap2-bin util-linux iproute2 \
    && rm -rf /var/lib/apt/lists/* \
    && case "$(dpkg --print-architecture)" in \
         arm64) node_arch=arm64; node_sha=fff4078c5def658577f92c88db7db3bc0072924bfb93fe52c1e744a54e94abb8 ;; \
         amd64) node_arch=x64; node_sha=d60acfe00a2932254bb0ad20e01b0d74397a0875595de719654b214f4b03f307 ;; \
         *) echo "unsupported Node architecture: $(dpkg --print-architecture)" >&2; exit 1 ;; \
       esac \
    && curl --fail --location --retry 5 \
         --output /tmp/node.tar.xz \
         "https://nodejs.org/dist/v22.23.2/node-v22.23.2-linux-${node_arch}.tar.xz" \
    && echo "${node_sha}  /tmp/node.tar.xz" | sha256sum --check --strict \
    && mkdir /tmp/node \
    && tar --extract --file /tmp/node.tar.xz --directory /tmp/node --strip-components=1 \
    && install -m 0755 /tmp/node/bin/node /usr/local/bin/node \
    && rm -rf /tmp/node /tmp/node.tar.xz \
    && test "$(node --version)" = v22.23.2 \
    && test ! -e /usr/local/bin/npm \
    && test ! -e /usr/local/bin/npx \
    && test ! -e /usr/local/bin/corepack \
    && test ! -e /usr/local/lib/node_modules

# ubuntu:24.04 ships a uid-1000 "ubuntu" user; remove it, then create "agent" as uid 1000.
RUN deluser --remove-home ubuntu 2>/dev/null || true; \
    userdel -f ubuntu 2>/dev/null || true; \
    groupdel ubuntu 2>/dev/null || true; \
    useradd --create-home --home-dir /home/agent --shell /bin/bash --uid 1000 --user-group agent \
    && groupadd --gid 1001 environment \
    && useradd --uid 1001 --gid environment --groups agent --no-create-home --home-dir /nonexistent environment \
    && mkdir -p /workspace /var/environment/ops /var/environment/bindings /var/environment/objects /var/environment/file-staging /var/environment/tools /usr/local/lib/environment \
    && chown -R agent:agent /workspace /home/agent \
    && chmod 2770 /workspace /home/agent \
    && chown environment:agent /var/environment \
    && chmod 0710 /var/environment \
    && chown -R environment:environment /var/environment/ops /var/environment/bindings /var/environment/objects \
    && chmod 0700 /var/environment/ops /var/environment/bindings /var/environment/objects \
    && chown -R environment:agent /var/environment/file-staging \
    && chmod 2700 /var/environment/file-staging \
    && chown -R environment:agent /var/environment/tools \
    && chmod 2750 /var/environment/tools \
    && test "$(stat -c '%d:%g' /workspace)" = "$(stat -c '%d:%g' /var/environment/file-staging)" \
    && test "$(stat -c '%a' /var/environment/file-staging)" = 2700

# Curated Tool code needs no package-owned privilege transition. Strip the entire distro/toolchain
# setuid, setgid and file-capability surface. The root-owned supervisor launcher transfers the exact
# three process capabilities needed by the supervisor; CI scans the completed image so a package
# update cannot silently reopen the filesystem privilege surface.
RUN find / -xdev -type f -perm /6000 -exec chmod a-s {} + \
    && getcap -r /usr /bin /sbin /usr/local 2>/dev/null \
         | awk '{print $1}' | sort -u | xargs -r -n1 setcap -r

ARG BIN
COPY ${BIN} /usr/local/bin/environment-guest
COPY image/tool-runner.mjs /usr/local/lib/environment/tool-runner.mjs
COPY image/tool-boundary.c /tmp/tool-boundary.c
COPY image/proc-secret-static.c /tmp/proc-secret-static.c
COPY image/supervisor-launcher.c /tmp/supervisor-launcher.c
COPY image/environment-boot.sh /usr/local/bin/environment-boot.sh
RUN chown root:environment /usr/local/bin/environment-guest \
    && chmod 0750 /usr/local/bin/environment-guest \
    && chmod 0755 /usr/local/bin/environment-boot.sh \
    && cc -shared -fPIC -O2 -Wl,-z,relro,-z,now \
         -o /usr/local/lib/environment/tool-boundary.so /tmp/tool-boundary.c \
    && cc -static -O2 -Wl,-z,relro,-z,now \
         -o /usr/local/lib/environment/proc-secret-static /tmp/proc-secret-static.c \
    && cc -O2 -Wl,-z,relro,-z,now \
         -o /usr/local/lib/environment/supervisor-launcher /tmp/supervisor-launcher.c \
    && rm /tmp/tool-boundary.c /tmp/proc-secret-static.c /tmp/supervisor-launcher.c \
    && chown root:root /usr/local/lib/environment/tool-boundary.so /usr/local/lib/environment/proc-secret-static \
    && chown root:environment /usr/local/lib/environment/supervisor-launcher \
    && chmod 0555 /usr/local/lib/environment/tool-boundary.so /usr/local/lib/environment/proc-secret-static \
    && chmod 0750 /usr/local/lib/environment/supervisor-launcher \
    && test "$(stat -c '%u:%g:%a' /usr/local/lib/environment/tool-boundary.so)" = "0:0:555" \
    && test "$(stat -c '%u:%g:%a' /usr/local/lib/environment/proc-secret-static)" = "0:0:555" \
    && ! readelf -l /usr/local/lib/environment/proc-secret-static | grep -q INTERP \
    && test "$(stat -c '%u:%g:%a' /usr/local/lib/environment/supervisor-launcher)" = "0:1001:750" \
    && test -z "$(find / -xdev -type f -perm /6000 -print -quit)" \
    && test -z "$(getcap -r / 2>/dev/null)"

WORKDIR /workspace
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/environment-boot.sh"]
