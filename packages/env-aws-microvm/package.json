{
  "name": "@aexhq/env-aws-microvm",
  "version": "2.0.0",
  "description": "AWS MicroVM remote Environment descriptor and provider runtime for Brain",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aexhq/extensions.git",
    "directory": "packages/env-aws-microvm"
  },
  "publishConfig": { "access": "public", "provenance": true, "tag": "next" },
  "type": "module",
  "engines": { "node": ">=22.0.0" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "runtime"],
  "scripts": {
    "build": "node ../../tools/clean-dist.mjs && tsc -p tsconfig.json",
    "test": "npm run build && node --test index.test.mjs",
    "test:runtime": "cargo test --manifest-path runtime/Cargo.toml --workspace --all-targets",
    "prepack": "npm run build"
  },
  "dependencies": { "@aexhq/brain": "0.16.0", "zod": "4.4.3" },
  "devDependencies": { "@types/node": "^24.3.0", "typescript": "^5.9.2" }
}
